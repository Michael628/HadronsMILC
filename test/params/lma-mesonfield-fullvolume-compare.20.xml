<grid>
  <modules>
    <!-- Gauge fields from the 4^4 test configuration set (trajectory suffix
    supplied by trajCounter). -->
    <module>
      <id><name>gauge</name><type>MIO::LoadIldg</type></id>
      <options><file>lat/lat.sample.l4444.ildg</file></options>
    </module>
    <module>
      <id><name>gauge_fat</name><type>MIO::LoadIldg</type></id>
      <options><file>lat/fatlinks.l4444.ildg</file></options>
    </module>
    <module>
      <id><name>gauge_long</name><type>MIO::LoadIldg</type></id>
      <options><file>lat/longlinks.l4444.ildg</file></options>
    </module>

    <!-- Massless action: the weighted branch reads both mass and lambda_D
         from epack.eval; the mass shift enters via ModifyEigenPack. -->
    <module>
      <id><name>stag</name><type>MAction::ImprovedStaggeredMILC</type></id>
      <options>
        <Ls>1</Ls>
        <boundary>1 1 1 1</boundary>
        <c1>1.0</c1>
        <c2>1.0</c2>
        <gaugefat>gauge_fat</gaugefat>
        <gaugelong>gauge_long</gaugelong>
        <mass>0.0</mass>
        <tad>1.0</tad>
        <twist>0 0 0</twist>
      </options>
    </module>
    <module>
      <id><name>stag_op</name><type>MFermion::StagOperators</type></id>
      <options><action>stag</action></options>
    </module>

    <!-- Checkerboarded massless eigenvectors. -->
    <module>
      <id><name>epack</name><type>MSolver::StagFermionIRL</type></id>
      <options>
        <evenEigen>true</evenEigen>
        <lanczosParams>
          <Cheby><Npoly>11</Npoly><alpha>0.0</alpha><beta>24.0</beta></Cheby>
          <MaxIt>5000</MaxIt>
          <MinRes>0</MinRes>
          <Nk>24</Nk>
          <Nm>32</Nm>
          <Nstop>20</Nstop>
          <betastp>0</betastp>
          <resid>1e-08</resid>
        </lanczosParams>
        <multiFile>false</multiFile>
        <op>stag_op_schur</op>
        <output></output>
        <redBlack>true</redBlack>
      </options>
    </module>

    <!-- Mass-shifted checkerboarded pack used by BOTH solvers. -->
    <module>
      <id><name>eig</name><type>MUtilities::ModifyEigenPackMILC</type></id>
      <options>
        <eigenPack>epack</eigenPack>
        <evenEigen>true</evenEigen>
        <mass>0.01</mass>
      </options>
    </module>

    <!-- Two distinct on-demand CB pair sources over the mass-shifted pack:
         mfwrite's low-mode rows come from these. Two instances are
         mandatory: the framework holds the right-side bank across the
         left-side block loop, so the sides cannot share one bank. -->
    <module>
      <id><name>cbpairs_l</name><type>MUtilities::EigenPackCBPairs</type></id>
      <options><action>stag</action><eigenPack>eig</eigenPack></options>
    </module>
    <module>
      <id><name>cbpairs_r</name><type>MUtilities::EigenPackCBPairs</type></id>
      <options><action>stag</action><eigenPack>eig</eigenPack></options>
    </module>

    <!-- Full-volume |e+o>/|e-o> pairs built from the checkerboarded pack.
         Probe basis only (cmp_ref/cmp_file contract solver outputs against
         eigfull_vec, a parity-complete basis). -->
    <module>
      <id><name>eigfull</name><type>MUtilities::EigenPackFullPairs</type></id>
      <options><eigenPack>eig</eigenPack><action>stag</action></options>
    </module>

    <!-- Production noise pipeline: full-volume noise feeds the meson-field
         writer RAW (below); a SEPARATE StagRandomWall consumer masks it to
         one timeslice for every solver/guess module -- bit-for-bit the
         production split (noise_fv/noise_t0,
         .../stat-high-thesis-ranLL-opt-e1000-n20-a.60.xml:172-190).
         nsrc=2 keeps RandomWall's output vector-typed (nSrc*nSlices=2,
         avoiding RandomWall.hpp:159's scalar collapse), matching
         production's always-vector-typed nSrc=20 shape. -->
    <module>
      <id><name>noise_fv</name><type>MNoise::StagFullVolumeSpinColorDiagonal</type></id>
      <options><nsrc>2</nsrc></options>
    </module>
    <module>
      <id><name>noise_t0</name><type>MSource::StagRandomWall</type></id>
      <options>
        <colorDiag>true</colorDiag>
        <nSrc>2</nSrc>
        <noise>noise_fv</noise>
        <reuset0>false</reuset0>
        <t0>0</t0>
        <tStep>4</tStep>
      </options>
    </module>

    <!-- ONE SpinTaste module for the identity operator shared by every
         consumer below (mfwrite, lma_file, cmp_ref, cmp_file all use the
         same (G1,G1), applyG5=false operator); declared before all four. -->
    <module>
      <id><name>gammas_g1</name><type>MFermion::SpinTaste</type></id>
      <options>
        <spinTaste>
          <gammas>(G1 G1)</gammas>
          <applyG5>false</applyG5>
          <gauge>gauge</gauge>
        </spinTaste>
        <labels></labels>
      </options>
    </module>

    <!-- Production-layout meson-field write: RAW full-volume noise
         (noise_fv_vec), never the RandomWall-masked source -- matching
         production's mfwrite_mass_l wiring. Writes
         work/mfout-fullvolume-compare.20/G1_G1_0_0_0.h5. -->
    <module>
      <id><name>mfwrite</name><type>MContraction::StagA2AMesonField</type></id>
      <options>
        <action></action>
        <block>12</block>
        <cbPairsLeft>cbpairs_l</cbPairsLeft>
        <cbPairsRight>cbpairs_r</cbPairsRight>
        <left></left>
        <lowModes>eig</lowModes>
        <mom><elem>0 0 0</elem></mom>
        <output>work/mfout-fullvolume-compare</output>
        <right>noise_fv_vec</right>
        <gammas>gammas_g1</gammas>
      </options>
    </module>

    <!-- Load it back. -->
    <module>
      <id><name>mf</name><type>MIO::LoadMesonField</type></id>
      <options>
        <file>work/mfout-fullvolume-compare.@traj@/G1_G1_0_0_0.h5</file>
        <dataset>G1_G1_0_0_0</dataset>
        <side></side>
        <lowModes></lowModes>
      </options>
    </module>

    <!-- Reference: live LowModeProj, WEIGHTED (invmag) branch -- the ONLY
         branch safe to use as a solver guess, matching production's
         quark_ranLL_* defaults (no <projector> element = "false"). -->
    <module>
      <id><name>lma_ref</name><type>MSolver::StagLMA</type></id>
      <options>
        <action>stag</action>
        <eigStart>0</eigStart>
        <lowModes>eig</lowModes>
        <nEigs>-1</nEigs>
        <projector>false</projector>
      </options>
    </module>

    <!-- File-driven propagator producer, WEIGHTED (invmag) branch: no
         <projector> element (empty string default = "false"), matching
         lma_ref above and production's quark_ranLL_* modules. tA=tB=0
         matches noise_t0's t0=0. -->
    <module>
      <id><name>lma_file</name><type>MFermion::StagLMAMesonFieldProp</type></id>
      <options>
        <action>stag</action>
        <lowModes>eig</lowModes>
        <gammas>gammas_g1</gammas>
        <labels>G1_G1</labels>
        <mesonField>mf</mesonField>
        <noiseIndex>0</noiseIndex>
        <nNoise>2</nNoise>
        <tA>0</tA>
        <tB>0</tB>
        <tStep>1</tStep>
        <eigStart>0</eigStart>
        <nEigs>-1</nEigs>
        <projector></projector>
        <negFirst></negFirst>
        <pairScale></pairScale>
        <noise>noise_fv_vec</noise>
      </options>
    </module>

    <!-- Apply the live reference solver to the RandomWall-masked source
         (noise_t0), matching production's real quark_ama_* input --
         never raw noise. StagGaugePropLegacy with a PropagatorField-typed
         source (colorDiag=true) publishes a vector<PropagatorField>
         output (GaugePropLegacy.hpp:196-215), not the vector<FermionField>
         the old TimeDiluted-noise harnesses produced here. -->
    <module>
      <id><name>gprop_ref</name><type>MFermion::StagGaugePropLegacy</type></id>
      <options>
        <source>noise_t0</source>
        <solver>lma_ref</solver>
        <guess></guess>
        <spinTaste>
          <applyG5>false</applyG5>
          <gammas>(G1 G1)</gammas>
          <gauge>gauge</gauge>
        </spinTaste>
      </options>
    </module>

    <!-- Bridge gprop_ref's vector<PropagatorField> to vector<FermionField>
         for the probe contraction (StagA2AMesonField's right takes
         vector<FermionField> only) -- the same bridge the file side below
         needs, since both sides are now PropagatorField-shaped. -->
    <module>
      <id><name>gprop_ref_f</name><type>MUtilities::PropToFermions</type></id>
      <options><prop>gprop_ref</prop></options>
    </module>

    <!-- Bridge lma_file_t0's G1_G1 entry onto a bare environment object
         (D6), then extract its 3 color columns per noise as a
         FermionField vector for the probe contraction (StagA2AMesonField
         takes vector<FermionField> only); entries are noise-major: entry
         n*3+c = table column (noiseIndex+n)*3+c. -->
    <module>
      <id><name>lma_fc_g1_t0</name><type>MUtilities::GammaMapElement</type></id>
      <options><map>lma_file_t0</map><label>G1_G1</label></options>
    </module>
    <module>
      <id><name>prop2f_file</name><type>MUtilities::PropToFermions</type></id>
      <options><prop>lma_fc_g1_t0</prop></options>
    </module>

    <!-- Probe contractions of both sides against the full eigenvector-pair
         basis (identity spin-taste, zero momentum); compared offline via
         compare_lma_mesonfield.py --ref work/lma-fullvolume-compare/ref
         --file work/lma-fullvolume-compare/file --nnoise 2 --tol 1e-6. -->
    <module>
      <id><name>cmp_ref</name><type>MContraction::StagA2AMesonField</type></id>
      <options>
        <action></action>
        <block>12</block>
        <left>eigfull_vec</left>
        <lowModes></lowModes>
        <mom><elem>0 0 0</elem></mom>
        <output>work/lma-fullvolume-compare/ref</output>
        <right>gprop_ref_f</right>
        <gammas>gammas_g1</gammas>
      </options>
    </module>
    <module>
      <id><name>cmp_file</name><type>MContraction::StagA2AMesonField</type></id>
      <options>
        <action></action>
        <block>12</block>
        <left>eigfull_vec</left>
        <lowModes></lowModes>
        <mom><elem>0 0 0</elem></mom>
        <output>work/lma-fullvolume-compare/file</output>
        <right>prop2f_file</right>
        <gammas>gammas_g1</gammas>
      </options>
    </module>
  </modules>
  <parameters>
    <genetic>
      <maxCstGen>100</maxCstGen>
      <maxGen>1000</maxGen>
      <mutationRate>0.1</mutationRate>
      <popSize>20</popSize>
    </genetic>
    <graphFile></graphFile>
    <parallelWriteMaxRetry>-1</parallelWriteMaxRetry>
    <runId>lma-fullvolume-compare</runId>
    <saveSchedule>false</saveSchedule>
    <scheduleFile></scheduleFile>
    <scheduler>
      <schedulerType>naive</schedulerType>
    </scheduler>
    <trajCounter>
      <end>10000</end>
      <start>20</start>
      <step>10000</step>
    </trajCounter>
  </parameters>
</grid>
