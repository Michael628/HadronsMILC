<grid>
  <parameters>
    <genetic>
      <maxCstGen>100</maxCstGen>
      <maxGen>1000</maxGen>
      <mutationRate>0.1</mutationRate>
      <popSize>20</popSize>
    </genetic>
    <graphFile></graphFile>
    <parallelWriteMaxRetry>-1</parallelWriteMaxRetry>
    <runId>IRL-exact-CB-mesons-384</runId>
    <saveSchedule>false</saveSchedule>
    <scheduleFile></scheduleFile>
    <trajCounter>
      <end>10000</end>
      <start>20</start>
      <step>10000</step>
    </trajCounter>
  </parameters>
  <modules>
    <!-- Same 4^4 test configuration used by the point-source and LMA tests. -->
    <module>
      <id>
        <name>gauge</name>
        <type>MIO::LoadIldg</type>
      </id>
      <options>
        <file>lat/lat.sample.l4444.ildg</file>
      </options>
    </module>
    <module>
      <id>
        <name>gauge_fat</name>
        <type>MIO::LoadIldg</type>
      </id>
      <options>
        <file>lat/fatlinks.l4444.ildg</file>
      </options>
    </module>
    <module>
      <id>
        <name>gauge_long</name>
        <type>MIO::LoadIldg</type>
      </id>
      <options>
        <file>lat/longlinks.l4444.ildg</file>
      </options>
    </module>
    <module>
      <id>
        <name>stag_mass_zero</name>
        <type>MAction::ImprovedStaggeredMILC</type>
      </id>
      <options>
        <Ls>1</Ls>
        <gaugefat>gauge_fat</gaugefat>
        <gaugelong>gauge_long</gaugelong>
        <mass>0.0</mass>
      </options>
    </module>
    <module>
      <id>
        <name>stag_op</name>
        <type>MFermion::StagOperators</type>
      </id>
      <options>
        <action>stag_mass_zero</action>
      </options>
    </module>
    <!--
      4^4 lattice, odd checkerboard: 4^4/2 * 3 colors = 384 is the *exact*
      dimension of the preconditioned operator, so requesting Nstop = Nk = 384
      with Nm = 385 forces IRL to span the full space and converge to machine
      precision in a single Lanczos pass (same setup as
      a2a-g1g1-irl-exact.20.xml).
    -->
    <module>
      <id>
        <name>epack</name>
        <type>MSolver::StagFermionIRL</type>
      </id>
      <options>
        <evenEigen>false</evenEigen>
        <lanczosParams>
          <Cheby>
            <Npoly>11</Npoly>
            <alpha>0.009</alpha>
            <beta>24.0</beta>
          </Cheby>
          <MaxIt>5000</MaxIt>
          <MinRes>0</MinRes>
          <Nk>384</Nk>
          <Nm>385</Nm>
          <Nstop>384</Nstop>
          <betastp>0</betastp>
          <resid>1e-08</resid>
        </lanczosParams>
        <multiFile>false</multiFile>
        <op>stag_op_schur</op>
        <output></output>
        <redBlack>true</redBlack>
      </options>
    </module>
    <module>
      <id>
        <name>evecs_mass_l</name>
        <type>MUtilities::ModifyEigenPackMILC</type>
      </id>
      <options>
        <eigenPack>epack</eigenPack>
        <evenEigen>false</evenEigen>
        <mass>0.1</mass>
        <normalizeCheckerboard>false</normalizeCheckerboard>
      </options>
    </module>
    <module>
      <id>
        <name>stag_mass_l</name>
        <type>MAction::ImprovedStaggeredMILC</type>
      </id>
      <options>
        <gaugefat>gauge_fat</gaugefat>
        <gaugelong>gauge_long</gaugelong>
        <mass>0.1</mass>
      </options>
    </module>
    <!--
      Two distinct pair-source instances over the same pack: the framework
      holds the right-side result across the whole left-side block loop, so
      the two sides cannot share one bank (distinct objects enforced at
      module setup and in A2AMatrixBlockComputationMILC::execute).
    -->
    <module>
      <id>
        <name>cbpairs_l</name>
        <type>MUtilities::EigenPackCBPairs</type>
      </id>
      <options>
        <action>stag_mass_l</action>
        <eigenPack>evecs_mass_l</eigenPack>
      </options>
    </module>
    <module>
      <id>
        <name>cbpairs_r</name>
        <type>MUtilities::EigenPackCBPairs</type>
      </id>
      <options>
        <action>stag_mass_l</action>
        <eigenPack>evecs_mass_l</eigenPack>
      </options>
    </module>
    <module>
      <id>
        <name>em</name>
        <type>MGauge::StochEmFunc</type>
      </id>
      <options>
        <gauge>feynman</gauge>
        <zmScheme>qedL</zmScheme>
        <improvement></improvement>
      </options>
    </module>
    <module>
      <id>
        <name>mf_ja_1link</name>
        <type>MContraction::StagA2AASlashOneLinkMesonField</type>
      </id>
      <options>
        <block>768</block>
        <left></left>
        <right></right>
        <lowModes>evecs_mass_l</lowModes>
        <cbPairsLeft>cbpairs_l</cbPairsLeft>
        <cbPairsRight>cbpairs_r</cbPairsRight>
        <mom>
          <elem>0 0 0</elem>
          <elem>1 0 0</elem>
        </mom>
        <output>work/ja1link/m01/mf</output>
        <gauge>gauge</gauge>
        <EmFunc>em</EmFunc>
        <nEmFields>2</nEmFields>
        <EmSeedString>ja1link-seed</EmSeedString>
      </options>
    </module>
  </modules>
</grid>
