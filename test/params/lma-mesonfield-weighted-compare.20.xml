<grid>
  <modules>
    <!-- Gauge fields from the 4^4 test configuration set (trajectory suffix
    supplied by trajCounter). -->
    <module>
      <id><name>gauge</name><type>MIO::LoadIldg</type></id>
      <options><file>lat/lat.sample.l4444.ildg</file></options>
    </module>
    <module>
      <id><name>gauge_fat</name><type>MIO::LoadIldg</type></id>
      <options><file>lat/fatlinks.l4444.ildg</file></options>
    </module>
    <module>
      <id><name>gauge_long</name><type>MIO::LoadIldg</type></id>
      <options><file>lat/longlinks.l4444.ildg</file></options>
    </module>

    <!-- Massless action: the weighted branch reads both mass and lambda_D
         from epack.eval; the mass shift enters via ModifyEigenPack. -->
    <module>
      <id><name>stag</name><type>MAction::ImprovedStaggeredMILC</type></id>
      <options>
        <Ls>1</Ls>
        <boundary>1 1 1 1</boundary>
        <c1>1.0</c1>
        <c2>1.0</c2>
        <gaugefat>gauge_fat</gaugefat>
        <gaugelong>gauge_long</gaugelong>
        <mass>0.0</mass>
        <tad>1.0</tad>
        <twist>0 0 0</twist>
      </options>
    </module>
    <module>
      <id><name>stag_op</name><type>MFermion::StagOperators</type></id>
      <options><action>stag</action></options>
    </module>

    <!-- Checkerboarded massless eigenvectors. -->
    <module>
      <id><name>epack</name><type>MSolver::StagFermionIRL</type></id>
      <options>
        <evenEigen>true</evenEigen>
        <lanczosParams>
          <Cheby><Npoly>11</Npoly><alpha>0.0</alpha><beta>24.0</beta></Cheby>
          <MaxIt>5000</MaxIt>
          <MinRes>0</MinRes>
          <Nk>24</Nk>
          <Nm>32</Nm>
          <Nstop>20</Nstop>
          <betastp>0</betastp>
          <resid>1e-08</resid>
        </lanczosParams>
        <multiFile>false</multiFile>
        <op>stag_op_schur</op>
        <output></output>
        <redBlack>true</redBlack>
      </options>
    </module>

    <!-- Mass-shifted checkerboarded pack used by BOTH solvers. -->
    <module>
      <id><name>eig</name><type>MUtilities::ModifyEigenPackMILC</type></id>
      <options>
        <eigenPack>epack</eigenPack>
        <evenEigen>true</evenEigen>
        <mass>0.01</mass>
      </options>
    </module>

    <!-- Two distinct on-demand CB pair sources over the mass-shifted pack:
         mfwrite's low-mode rows come from these (odd partner = Meooe(e_E)/
         (i*lam) filled on demand - no full-grid pair fields ever
         materialize). Two instances are mandatory: the framework holds the
         right-side bank across the left-side block loop, so the sides
         cannot share one bank. -->
    <module>
      <id><name>cbpairs_l</name><type>MUtilities::EigenPackCBPairs</type></id>
      <options><action>stag</action><eigenPack>eig</eigenPack></options>
    </module>
    <module>
      <id><name>cbpairs_r</name><type>MUtilities::EigenPackCBPairs</type></id>
      <options><action>stag</action><eigenPack>eig</eigenPack></options>
    </module>

    <!-- Full-volume |e+o>/|e-o> pairs built from the checkerboarded pack.
         Probe basis only (cmp_ref/cmp_file contract solver outputs against
         eigfull_vec, a parity-complete basis); the production file below is
         written from the CB pair sources instead - the two layouts produce
         numerically identical rows (writer CB 1/sqrt(2) norm reduction). -->
    <module>
      <id><name>eigfull</name><type>MUtilities::EigenPackFullPairs</type></id>
      <options><eigenPack>eig</eigenPack><action>stag</action></options>
    </module>

    <!-- Time-diluted noise, production noise-index layout: nsrc=2,
         tStep=nt=4 - noise_vec holds exactly nsrc*3 = 6 entries, both
         noises on timeslice 0 (every block maps to t=0 when tStep=nt). -->
    <module>
      <id><name>noise</name><type>MNoise::StagTimeDilutedSpinColorDiagonal</type></id>
      <options><nsrc>2</nsrc><tStep>4</tStep></options>
    </module>

    <!-- ONE SpinTaste module for the identity operator shared by every
         consumer below (mfwrite, lma_file, cmp_ref, cmp_file all use the
         same (G1,G1), applyG5=false operator); declared before all four. -->
    <module>
      <id><name>gammas_g1</name><type>MFermion::SpinTaste</type></id>
      <options>
        <spinTaste>
          <gammas>(G1 G1)</gammas>
          <applyG5>false</applyG5>
          <gauge>gauge</gauge>
        </spinTaste>
        <labels></labels>
      </options>
    </module>

    <!-- Production-layout meson-field write: left empty (eigenvector rows =
         the CB pair rows of 'eig', reconstructed to the legacy interleaved
         2k/2k+1 = M0+/-M1 layout by the writer), right = noise, identity
         spin-taste, zero momentum. Writes mfout-weighted.20/G1_G1_0_0_0.h5,
         a distinct path from lma-mesonfield-file-compare.20.xml's
         work/mfout so both tests' work/ output can coexist. -->
    <module>
      <id><name>mfwrite</name><type>MContraction::StagA2AMesonField</type></id>
      <options>
        <action></action>
        <block>12</block>
        <cbPairsLeft>cbpairs_l</cbPairsLeft>
        <cbPairsRight>cbpairs_r</cbPairsRight>
        <left></left>
        <lowModes>eig</lowModes>
        <mom><elem>0 0 0</elem></mom>
        <output>work/mfout-weighted</output>
        <right>noise_vec</right>
        <gammas>gammas_g1</gammas>
      </options>
    </module>

    <!-- Load it back. -->
    <module>
      <id><name>mf</name><type>MIO::LoadMesonField</type></id>
      <options>
        <file>work/mfout-weighted.@traj@/G1_G1_0_0_0.h5</file>
        <dataset>G1_G1_0_0_0</dataset>
        <side></side>
        <lowModes></lowModes>
      </options>
    </module>

    <!-- Reference: live LowModeProj, WEIGHTED (invmag) branch, the
         branch this plan's Phase 1 fix targets, and the branch the
         Phase 2 guess-quality test shows is still wrong (file-guess
         residual ~1.9x worse than zero-guess). Every other module in
         this file is an exact clone of lma-mesonfield-file-compare.20's
         graph; only this and lma_file's <projector> differ. -->
    <module>
      <id><name>lma_ref</name><type>MSolver::StagLMA</type></id>
      <options>
        <action>stag</action>
        <eigStart>0</eigStart>
        <lowModes>eig</lowModes>
        <nEigs>-1</nEigs>
        <projector>false</projector>
      </options>
    </module>

    <!-- File-driven propagator producer, WEIGHTED (invmag) branch: no
         <projector> element (empty string default = "false" = the
         weighted formula, matching lma_ref above). Same nNoise/gammas/
         labels/mesonField wiring as lma-mesonfield-file-compare.20's
         lma_file. -->
    <module>
      <id><name>lma_file</name><type>MFermion::StagLMAMesonFieldProp</type></id>
      <options>
        <action>stag</action>
        <lowModes>eig</lowModes>
        <gammas>gammas_g1</gammas>
        <labels>G1_G1</labels>
        <mesonField>mf</mesonField>
        <noiseIndex>0</noiseIndex>
        <nNoise>2</nNoise>
        <tA>0</tA>
        <tB>0</tB>
        <tStep>1</tStep>
        <eigStart>0</eigStart>
        <nEigs>-1</nEigs>
        <projector></projector>
        <negFirst></negFirst>
        <pairScale></pairScale>
        <noise>noise_vec</noise>
      </options>
    </module>

    <!-- Apply the live reference solver to the same raw noise fields:
         GaugeProp with identity spin-taste (D5 empty-gammas legacy path)
         and no guess is a plain per-field solver application,
         out[i] = solver(noise_vec[i]). Empty gammas -> bare module name
         as the output object (vector<FermionField>). -->
    <module>
      <id><name>gprop_ref</name><type>MFermion::StagGaugePropLegacy</type></id>
      <options>
        <source>noise_vec</source>
        <solver>lma_ref</solver>
        <guess></guess>
        <spinTaste>
          <applyG5>false</applyG5>
          <gammas>(G1 G1)</gammas>
          <gauge>gauge</gauge>
        </spinTaste>
      </options>
    </module>

    <!-- Bridge lma_file_t0's G1_G1 entry onto a bare environment object
         (D6), then extract its 3 color columns as a FermionField vector
         for the probe contraction (StagA2AMesonField takes
         vector<FermionField> only); entries are noise-major: entry n*3+c
         = table column (noiseIndex+n)*3 + c, comparable one-to-one to
         the reference probe's 6 noise columns (gprop_ref applies the
         live solver to every noise field; columns 0-2/3-5 are the three
         colors of noises 0/1 at t=0). -->
    <module>
      <id><name>lma_fc_g1_t0</name><type>MUtilities::GammaMapElement</type></id>
      <options><map>lma_file_t0</map><label>G1_G1</label></options>
    </module>
    <module>
      <id><name>prop2f_file</name><type>MUtilities::PropToFermions</type></id>
      <options><prop>lma_fc_g1_t0</prop></options>
    </module>

    <!-- Probe contractions of both sides against the full eigenvector-pair
         basis (identity spin-taste, zero momentum); row pairs expose even
         AND odd content of the outputs; compared offline with h5py via
         the existing compare_lma_mesonfield.py (its ref/file path flags
         point at these two output dirs instead of lma-file-compare's). -->
    <module>
      <id><name>cmp_ref</name><type>MContraction::StagA2AMesonField</type></id>
      <options>
        <action></action>
        <block>12</block>
        <left>eigfull_vec</left>
        <lowModes></lowModes>
        <mom><elem>0 0 0</elem></mom>
        <output>work/lma-weighted-compare/ref</output>
        <right>gprop_ref</right>
        <gammas>gammas_g1</gammas>
      </options>
    </module>
    <module>
      <id><name>cmp_file</name><type>MContraction::StagA2AMesonField</type></id>
      <options>
        <action></action>
        <block>12</block>
        <left>eigfull_vec</left>
        <lowModes></lowModes>
        <mom><elem>0 0 0</elem></mom>
        <output>work/lma-weighted-compare/file</output>
        <right>prop2f_file</right>
        <gammas>gammas_g1</gammas>
      </options>
    </module>
  </modules>
  <parameters>
    <genetic>
      <maxCstGen>100</maxCstGen>
      <maxGen>1000</maxGen>
      <mutationRate>0.1</mutationRate>
      <popSize>20</popSize>
    </genetic>
    <graphFile></graphFile>
    <parallelWriteMaxRetry>-1</parallelWriteMaxRetry>
    <runId>lma-weighted-compare</runId>
    <saveSchedule>false</saveSchedule>
    <scheduleFile></scheduleFile>
    <scheduler>
      <!-- naive: modules run in declaration order. Required here, since the
           genetic scheduler sees no dependency edge between the writer
           (mfwrite) and the loader (mf) (the meson-field file on disk is
           not an environment object), and may schedule the load before
           the write. Declaration order runs mfwrite before mf. -->
      <schedulerType>naive</schedulerType>
    </scheduler>
    <trajCounter>
      <end>10000</end>
      <start>20</start>
      <step>10000</step>
    </trajCounter>
  </parameters>
</grid>
