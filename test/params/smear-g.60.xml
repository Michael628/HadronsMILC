<grid>
  <modules>
    <module>
      <id>
        <name>gauge</name>
        <type>MIO::LoadIldg</type>
      </id>
      <options>
        <file>lat/lat.sample.l4444.ildg</file>
        <exitOnChecksumMismatch>false</exitOnChecksumMismatch>
      </options>
    </module>
    <module>
      <id>
        <name>gauge_smear</name>
        <type>MGauge::HISQSmear</type>
      </id>
      <options>
        <boundary>1 1 1 -1</boundary>
        <gauge>gauge</gauge>
      </options>
    </module>
    <module>
      <id>
        <name>save_fat</name>
        <type>MIO::SaveIldg</type>
      </id>
      <options>
        <ensembleLabel></ensembleLabel>
        <fileStem>lat/test-fatlinks.l4444.ildg</fileStem>
        <gauge>gauge_smear_fat</gauge>
      </options>
    </module>
    <module>
      <id>
        <name>save_long</name>
        <type>MIO::SaveIldg</type>
      </id>
      <options>
        <ensembleLabel></ensembleLabel>
        <fileStem>lat/test-longlinks.l4444.ildg</fileStem>
        <gauge>gauge_smear_long</gauge>
      </options>
    </module>
    <module>
      <id>
        <name>gauge_apbc</name>
        <type>MGauge::APBCGauge</type>
      </id>
      <options>
        <boundary>1 1 1 -1</boundary>
        <gauge>gauge</gauge>
      </options>
    </module>
  </modules>
  <parameters>
    <genetic>
      <maxCstGen>100</maxCstGen>
      <maxGen>1000</maxGen>
      <mutationRate>0.1</mutationRate>
      <popSize>20</popSize>
    </genetic>
    <graphFile></graphFile>
    <parallelWriteMaxRetry>-1</parallelWriteMaxRetry>
    <runId>LMI-RW-series-g-1000-eigs-1-noise</runId>
    <saveSchedule>false</saveSchedule>
    <scheduleFile></scheduleFile>
    <trajCounter>
      <end>10000</end>
      <start>20</start>
      <step>10000</step>
    </trajCounter>
  </parameters>
</grid>
