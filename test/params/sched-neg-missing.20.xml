<grid>
  <parameters>
    <genetic>
      <maxCstGen>100</maxCstGen>
      <maxGen>1000</maxGen>
      <mutationRate>0.1</mutationRate>
      <popSize>20</popSize>
    </genetic>
    <graphFile></graphFile>
    <parallelWriteMaxRetry>-1</parallelWriteMaxRetry>
    <runId>SCHED-NEG-MISSING-384</runId>
    <saveSchedule>false</saveSchedule>
    <scheduleFile>params/sched-neg-missing.20.sched</scheduleFile>
    <trajCounter>
      <end>10000</end>
      <start>20</start>
      <step>10000</step>
    </trajCounter>
  </parameters>
  <!-- Negative fixture: the loaded schedule drops the gauge module so
       executeProgram's program validation must abort with "missing from the
       program" before any module runs. Module set and options follow the
       a2a-g1g1-irl-exact.20.xml test configuration extended with the
       cbpairs_l/cbpairs_r pair-source modules required by the current
       StagA2AMesonField checkerboard guard (see test/README.md). -->
  <modules>
    <module>
      <id>
        <name>gauge</name>
        <type>MIO::LoadIldg</type>
      </id>
      <options>
        <file>lat/lat.sample.l4444.ildg</file>
      </options>
    </module>
    <module>
      <id>
        <name>gauge_fat</name>
        <type>MIO::LoadIldg</type>
      </id>
      <options>
        <file>lat/fatlinks.l4444.ildg</file>
      </options>
    </module>
    <module>
      <id>
        <name>gauge_long</name>
        <type>MIO::LoadIldg</type>
      </id>
      <options>
        <file>lat/longlinks.l4444.ildg</file>
      </options>
    </module>
    <module>
      <id>
        <name>stag_mass_zero</name>
        <type>MAction::ImprovedStaggeredMILC</type>
      </id>
      <options>
        <Ls>1</Ls>
        <gaugefat>gauge_fat</gaugefat>
        <gaugelong>gauge_long</gaugelong>
        <mass>0.0</mass>
      </options>
    </module>
    <module>
      <id>
        <name>stag_op</name>
        <type>MFermion::StagOperators</type>
      </id>
      <options>
        <action>stag_mass_zero</action>
      </options>
    </module>
    <module>
      <id>
        <name>epack</name>
        <type>MSolver::StagFermionIRL</type>
      </id>
      <options>
        <evenEigen>false</evenEigen>
        <lanczosParams>
          <Cheby>
            <Npoly>11</Npoly>
            <alpha>0.009</alpha>
            <beta>24.0</beta>
          </Cheby>
          <MaxIt>5000</MaxIt>
          <MinRes>0</MinRes>
          <Nk>384</Nk>
          <Nm>385</Nm>
          <Nstop>384</Nstop>
          <betastp>0</betastp>
          <resid>1e-08</resid>
        </lanczosParams>
        <multiFile>false</multiFile>
        <op>stag_op_schur</op>
        <output></output>
        <redBlack>true</redBlack>
      </options>
    </module>
    <module>
      <id>
        <name>evecs_mass_l</name>
        <type>MUtilities::ModifyEigenPackMILC</type>
      </id>
      <options>
        <eigenPack>epack</eigenPack>
        <evenEigen>false</evenEigen>
        <mass>0.1</mass>
        <normalizeCheckerboard>false</normalizeCheckerboard>
      </options>
    </module>
    <module>
      <id>
        <name>stag_mass_l</name>
        <type>MAction::ImprovedStaggeredMILC</type>
      </id>
      <options>
        <gaugefat>gauge_fat</gaugefat>
        <gaugelong>gauge_long</gaugelong>
        <mass>0.1</mass>
      </options>
    </module>
    <module>
      <id>
        <name>gammas_g1g1</name>
        <type>MFermion::SpinTaste</type>
      </id>
      <options>
        <spinTaste>
          <gammas>(G1 G1)</gammas>
          <applyG5>false</applyG5>
          <gauge>gauge</gauge>
        </spinTaste>
      </options>
    </module>
    <module>
      <id>
        <name>mf_g1g1_mass_l</name>
        <type>MContraction::StagA2AMesonField</type>
      </id>
      <options>
        <action>stag_mass_l</action>
        <block>768</block>
        <cbPairsLeft>cbpairs_l</cbPairsLeft>
        <cbPairsRight>cbpairs_r</cbPairsRight>
        <left></left>
        <lowModes>evecs_mass_l</lowModes>
        <mom>
          <elem>0 0 0</elem>
        </mom>
        <output>work/sched-neg-missing/mesons/m01/mf</output>
        <right></right>
        <gammas>gammas_g1g1</gammas>
      </options>
    </module>
    <module>
      <id>
        <name>cbpairs_l</name>
        <type>MUtilities::EigenPackCBPairs</type>
      </id>
      <options>
        <action>stag_mass_l</action>
        <eigenPack>evecs_mass_l</eigenPack>
      </options>
    </module>
    <module>
      <id>
        <name>cbpairs_r</name>
        <type>MUtilities::EigenPackCBPairs</type>
      </id>
      <options>
        <action>stag_mass_l</action>
        <eigenPack>evecs_mass_l</eigenPack>
      </options>
    </module>
  </modules>
</grid>
