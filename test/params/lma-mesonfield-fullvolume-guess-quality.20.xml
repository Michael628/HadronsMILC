<grid>
  <modules>
    <module>
      <id><name>gauge</name><type>MIO::LoadIldg</type></id>
      <options><file>lat/lat.sample.l4444.ildg</file></options>
    </module>
    <module>
      <id><name>gauge_fat</name><type>MIO::LoadIldg</type></id>
      <options><file>lat/fatlinks.l4444.ildg</file></options>
    </module>
    <module>
      <id><name>gauge_long</name><type>MIO::LoadIldg</type></id>
      <options><file>lat/longlinks.l4444.ildg</file></options>
    </module>
    <module>
      <id><name>stag</name><type>MAction::ImprovedStaggeredMILC</type></id>
      <options>
        <Ls>1</Ls>
        <boundary>1 1 1 1</boundary>
        <c1>1.0</c1>
        <c2>1.0</c2>
        <gaugefat>gauge_fat</gaugefat>
        <gaugelong>gauge_long</gaugelong>
        <mass>0.0</mass>
        <tad>1.0</tad>
        <twist>0 0 0</twist>
      </options>
    </module>
    <module>
      <id><name>stag_op</name><type>MFermion::StagOperators</type></id>
      <options><action>stag</action></options>
    </module>
    <!-- Massive double/single-precision action pair for a real mixed-
         precision CG solve, mirroring production's stag_mass_l/
         istag_mass_l pair (mass matches the eig mass shift below). -->
    <module>
      <id><name>stag_m</name><type>MAction::ImprovedStaggeredMILC</type></id>
      <options>
        <Ls>1</Ls>
        <boundary>1 1 1 1</boundary>
        <c1>1.0</c1>
        <c2>1.0</c2>
        <gaugefat>gauge_fat</gaugefat>
        <gaugelong>gauge_long</gaugelong>
        <mass>0.01</mass>
        <tad>1.0</tad>
        <twist>0 0 0</twist>
      </options>
    </module>
    <module>
      <id><name>gauge_fatf</name><type>MUtilities::GaugeSinglePrecisionCast</type></id>
      <options><field>gauge_fat</field></options>
    </module>
    <module>
      <id><name>gauge_longf</name><type>MUtilities::GaugeSinglePrecisionCast</type></id>
      <options><field>gauge_long</field></options>
    </module>
    <module>
      <id><name>istag_m</name><type>MAction::ImprovedStaggeredMILCF</type></id>
      <options>
        <Ls>1</Ls>
        <boundary>1 1 1 1</boundary>
        <c1>1.0</c1>
        <c2>1.0</c2>
        <gaugefat>gauge_fatf</gaugefat>
        <gaugelong>gauge_longf</gaugelong>
        <mass>0.01</mass>
        <tad>1.0</tad>
        <twist>0 0 0</twist>
      </options>
    </module>
    <module>
      <id><name>stag_ama</name><type>MSolver::StagMixedPrecisionCG</type></id>
      <options>
        <innerAction>istag_m</innerAction>
        <isEven>false</isEven>
        <maxInnerIteration>10000</maxInnerIteration>
        <maxOuterIteration>10000</maxOuterIteration>
        <outerAction>stag_m</outerAction>
        <residual>1e-08</residual>
      </options>
    </module>
    <module>
      <id><name>epack</name><type>MSolver::StagFermionIRL</type></id>
      <options>
        <evenEigen>true</evenEigen>
        <lanczosParams>
          <Cheby><Npoly>11</Npoly><alpha>0.0</alpha><beta>24.0</beta></Cheby>
          <MaxIt>5000</MaxIt>
          <MinRes>0</MinRes>
          <Nk>370</Nk>
          <Nm>384</Nm>
          <Nstop>360</Nstop>
          <betastp>0</betastp>
          <resid>1e-08</resid>
        </lanczosParams>
        <multiFile>false</multiFile>
        <op>stag_op_schur</op>
        <output></output>
        <redBlack>true</redBlack>
      </options>
    </module>
    <module>
      <id><name>eig</name><type>MUtilities::ModifyEigenPackMILC</type></id>
      <options>
        <eigenPack>epack</eigenPack>
        <evenEigen>true</evenEigen>
        <mass>0.01</mass>
      </options>
    </module>
    <module>
      <id><name>cbpairs_l</name><type>MUtilities::EigenPackCBPairs</type></id>
      <options><action>stag</action><eigenPack>eig</eigenPack></options>
    </module>
    <module>
      <id><name>cbpairs_r</name><type>MUtilities::EigenPackCBPairs</type></id>
      <options><action>stag</action><eigenPack>eig</eigenPack></options>
    </module>
    <module>
      <id><name>eigfull</name><type>MUtilities::EigenPackFullPairs</type></id>
      <options><eigenPack>eig</eigenPack><action>stag</action></options>
    </module>
    <!-- Production noise pipeline: same split as Phase 1 -- raw noise
         feeds the writer, RandomWall-masked noise feeds every
         solver/guess module. -->
    <module>
      <id><name>noise_fv</name><type>MNoise::StagFullVolumeSpinColorDiagonal</type></id>
      <options><nsrc>2</nsrc></options>
    </module>
    <module>
      <id><name>noise_t0</name><type>MSource::StagRandomWall</type></id>
      <options>
        <colorDiag>true</colorDiag>
        <nSrc>2</nSrc>
        <noise>noise_fv</noise>
        <reuset0>false</reuset0>
        <t0>0</t0>
        <tStep>4</tStep>
      </options>
    </module>
    <module>
      <id><name>gammas_g1</name><type>MFermion::SpinTaste</type></id>
      <options>
        <spinTaste>
          <gammas>(G1 G1)</gammas>
          <applyG5>false</applyG5>
          <gauge>gauge</gauge>
        </spinTaste>
        <labels></labels>
      </options>
    </module>
    <module>
      <id><name>mfwrite</name><type>MContraction::StagA2AMesonField</type></id>
      <options>
        <action></action>
        <block>12</block>
        <cbPairsLeft>cbpairs_l</cbPairsLeft>
        <cbPairsRight>cbpairs_r</cbPairsRight>
        <left></left>
        <lowModes>eig</lowModes>
        <mom><elem>0 0 0</elem></mom>
        <output>work/mfout-fullvolume-guess</output>
        <right>noise_fv_vec</right>
        <gammas>gammas_g1</gammas>
      </options>
    </module>
    <module>
      <id><name>mf</name><type>MIO::LoadMesonField</type></id>
      <options>
        <file>work/mfout-fullvolume-guess.@traj@/G1_G1_0_0_0.h5</file>
        <dataset>G1_G1_0_0_0</dataset>
        <side></side>
        <lowModes></lowModes>
      </options>
    </module>
    <!-- lma_ref: WEIGHTED (invmag) branch, the ONLY form safe to use as a
         solver guess (LMAMesonFieldProp.hpp's documented projector
         contract) -- deliberately projector=false here, unlike the
         time-diluted precedent (lma-mesonfield-guess-quality.20.xml)
         which used projector=true for this module: that value produces
         a bare projection, not a solution, and is not a meaningful
         "live guess" baseline for a real deflation measurement. -->
    <module>
      <id><name>lma_ref</name><type>MSolver::StagLMA</type></id>
      <options>
        <action>stag</action>
        <eigStart>0</eigStart>
        <lowModes>eig</lowModes>
        <nEigs>-1</nEigs>
        <projector>false</projector>
      </options>
    </module>
    <module>
      <id><name>lma_file</name><type>MFermion::StagLMAMesonFieldProp</type></id>
      <options>
        <action>stag</action>
        <lowModes>eig</lowModes>
        <gammas>gammas_g1</gammas>
        <labels>G1_G1</labels>
        <mesonField>mf</mesonField>
        <noiseIndex>0</noiseIndex>
        <nNoise>2</nNoise>
        <tA>0</tA>
        <tB>0</tB>
        <tStep>1</tStep>
        <eigStart>0</eigStart>
        <nEigs>-1</nEigs>
        <projector></projector>
        <negFirst></negFirst>
        <pairScale></pairScale>
        <noise>noise_fv_vec</noise>
      </options>
    </module>
    <!-- Live-guess reference: MODERN StagGaugeProp (not Legacy), so its
         output is TGammaMap-typed and directly usable as quark_liveguess's
         guess= below -- LowModeProj's Solver only supports the 2-arg call
         (no gfn_, LowModeProj.hpp:194-226), so guess="" here is required. -->
    <module>
      <id><name>gprop_ref</name><type>MFermion::StagGaugeProp</type></id>
      <options>
        <source>noise_t0</source>
        <solver>lma_ref</solver>
        <guess></guess>
        <gammas>gammas_g1</gammas>
        <sourceLabel></sourceLabel>
      </options>
    </module>
    <!-- Three guess comparisons, all through the MODERN StagGaugeProp --
         production's actual quark_ama_*_t0 dispatch (TGammaMap-typed
         guess=, per-gamma lookup), not StagGaugePropLegacy. No
         GammaMapElement/PropToFermions bridge needed: lma_file_t0 and
         gprop_ref are already TGammaMap<vector<PropagatorField>>-typed,
         directly consumable as guess=. -->
    <module>
      <id><name>quark_zeroguess</name><type>MFermion::StagGaugeProp</type></id>
      <options>
        <source>noise_t0</source>
        <solver>stag_ama</solver>
        <guess></guess>
        <gammas>gammas_g1</gammas>
        <sourceLabel></sourceLabel>
      </options>
    </module>
    <module>
      <id><name>quark_liveguess</name><type>MFermion::StagGaugeProp</type></id>
      <options>
        <source>noise_t0</source>
        <solver>stag_ama</solver>
        <guess>gprop_ref</guess>
        <gammas>gammas_g1</gammas>
        <sourceLabel></sourceLabel>
      </options>
    </module>
    <module>
      <id><name>quark_fileguess</name><type>MFermion::StagGaugeProp</type></id>
      <options>
        <source>noise_t0</source>
        <solver>stag_ama</solver>
        <guess>lma_file_t0</guess>
        <gammas>gammas_g1</gammas>
        <sourceLabel></sourceLabel>
      </options>
    </module>
  </modules>
  <parameters>
    <genetic>
      <maxCstGen>100</maxCstGen>
      <maxGen>1000</maxGen>
      <mutationRate>0.1</mutationRate>
      <popSize>20</popSize>
    </genetic>
    <graphFile></graphFile>
    <parallelWriteMaxRetry>-1</parallelWriteMaxRetry>
    <runId>lma-fullvolume-guess-quality</runId>
    <saveSchedule>false</saveSchedule>
    <scheduleFile></scheduleFile>
    <scheduler>
      <schedulerType>naive</schedulerType>
    </scheduler>
    <trajCounter>
      <end>10000</end>
      <start>20</start>
      <step>10000</step>
    </trajCounter>
  </parameters>
</grid>
