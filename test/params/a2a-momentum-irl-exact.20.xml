<grid>
  <parameters>
    <genetic>
      <maxCstGen>100</maxCstGen>
      <maxGen>1000</maxGen>
      <mutationRate>0.1</mutationRate>
      <popSize>20</popSize>
    </genetic>
    <graphFile></graphFile>
    <parallelWriteMaxRetry>-1</parallelWriteMaxRetry>
    <runId>IRL-exact-momentum-384</runId>
    <saveSchedule>false</saveSchedule>
    <scheduleFile></scheduleFile>
    <trajCounter>
      <end>10000</end>
      <start>20</start>
      <step>10000</step>
    </trajCounter>
  </parameters>
  <modules>
    <!-- Same 4^4 test configuration used by the point-source and LMA tests. -->
    <module>
      <id>
        <name>gauge</name>
        <type>MIO::LoadIldg</type>
      </id>
      <options>
        <file>lat/lat.sample.l4444.ildg</file>
      </options>
    </module>
    <module>
      <id>
        <name>gauge_fat</name>
        <type>MIO::LoadIldg</type>
      </id>
      <options>
        <file>lat/fatlinks.l4444.ildg</file>
      </options>
    </module>
    <module>
      <id>
        <name>gauge_long</name>
        <type>MIO::LoadIldg</type>
      </id>
      <options>
        <file>lat/longlinks.l4444.ildg</file>
      </options>
    </module>
    <module>
      <id>
        <name>stag_mass_zero</name>
        <type>MAction::ImprovedStaggeredMILC</type>
      </id>
      <options>
        <Ls>1</Ls>
        <gaugefat>gauge_fat</gaugefat>
        <gaugelong>gauge_long</gaugelong>
        <mass>0.0</mass>
      </options>
    </module>
    <module>
      <id>
        <name>stag_op</name>
        <type>MFermion::StagOperators</type>
      </id>
      <options>
        <action>stag_mass_zero</action>
      </options>
    </module>
    <!--
      4^4 lattice, odd checkerboard: 4^4/2 * 3 colors = 384 is the *exact*
      dimension of the preconditioned operator, so requesting Nstop = Nk = 384
      with Nm = 385 forces IRL to span the full space and converge to machine
      precision in a single Lanczos pass (no restarts, no truncation) rather
      than approximating a low-mode subspace.
    -->
    <module>
      <id>
        <name>epack</name>
        <type>MSolver::StagFermionIRL</type>
      </id>
      <options>
        <evenEigen>false</evenEigen>
        <lanczosParams>
          <Cheby>
            <Npoly>11</Npoly>
            <alpha>0.009</alpha>
            <beta>24.0</beta>
          </Cheby>
          <MaxIt>5000</MaxIt>
          <MinRes>0</MinRes>
          <Nk>384</Nk>
          <Nm>385</Nm>
          <Nstop>384</Nstop>
          <betastp>0</betastp>
          <resid>1e-08</resid>
        </lanczosParams>
        <multiFile>false</multiFile>
        <op>stag_op_schur</op>
        <output></output>
        <redBlack>true</redBlack>
      </options>
    </module>
    <module>
      <id>
        <name>evecs_mass_l</name>
        <type>MUtilities::ModifyEigenPackMILC</type>
      </id>
      <options>
        <eigenPack>epack</eigenPack>
        <evenEigen>false</evenEigen>
        <mass>0.1</mass>
        <normalizeCheckerboard>false</normalizeCheckerboard>
      </options>
    </module>
    <module>
      <id>
        <name>stag_mass_l</name>
        <type>MAction::ImprovedStaggeredMILC</type>
      </id>
      <options>
        <gaugefat>gauge_fat</gaugefat>
        <gaugelong>gauge_long</gaugelong>
        <mass>0.1</mass>
      </options>
    </module>
    <!--
      Red-black IRL eigenvectors need CB pair sources for the stencil
      meson-field module (the rb-evec guard rejects bare lowModes).
    -->
    <module>
      <id>
        <name>cbpairs_l</name>
        <type>MUtilities::EigenPackCBPairs</type>
      </id>
      <options>
        <action>stag_mass_l</action>
        <eigenPack>evecs_mass_l</eigenPack>
      </options>
    </module>
    <module>
      <id>
        <name>cbpairs_r</name>
        <type>MUtilities::EigenPackCBPairs</type>
      </id>
      <options>
        <action>stag_mass_l</action>
        <eigenPack>evecs_mass_l</eigenPack>
      </options>
    </module>
    <!-- Two gammas (pc0 + pc1) so a transposed (momentum, gamma) allocation
         is detectable: nMom != nGamma makes the wrong flat-slot mapping put
         mismatched content in every file. -->
    <module>
      <id>
        <name>gammas_two</name>
        <type>MFermion::SpinTaste</type>
      </id>
      <options>
        <spinTaste>
          <gammas>(G1 G1) (GX G1)</gammas>
          <applyG5>false</applyG5>
          <gauge>gauge</gauge>
        </spinTaste>
        <labels></labels>
      </options>
    </module>
    <!-- Zero-momentum control (the pre-momentum convention). -->
    <module>
      <id>
        <name>mf_zero_ctl</name>
        <type>MContraction::StagA2AMesonField</type>
      </id>
      <options>
        <block>768</block>
        <cbPairsLeft>cbpairs_l</cbPairsLeft>
        <cbPairsRight>cbpairs_r</cbPairsRight>
        <left></left>
        <lowModes>evecs_mass_l</lowModes>
        <mom>
          <elem>0 0 0</elem>
        </mom>
        <output>work/e384n1dt1-momtest/mesons/m01/mf_ctl</output>
        <right></right>
        <gammas>gammas_two</gammas>
      </options>
    </module>
    <!-- Multi-momentum: 6 momenta incl. the zero entry; the p=0 files must
         be value-identical to the control module's files. -->
    <module>
      <id>
        <name>mf_mom</name>
        <type>MContraction::StagA2AMesonField</type>
      </id>
      <options>
        <block>768</block>
        <cbPairsLeft>cbpairs_l</cbPairsLeft>
        <cbPairsRight>cbpairs_r</cbPairsRight>
        <left></left>
        <lowModes>evecs_mass_l</lowModes>
        <mom>
          <elem>0 0 0</elem>
          <elem>1 0 0</elem>
          <elem>0 1 0</elem>
          <elem>0 0 1</elem>
          <elem>1 1 1</elem>
          <elem>2 0 0</elem>
        </mom>
        <output>work/e384n1dt1-momtest/mesons/m01/mf_mom</output>
        <right></right>
        <gammas>gammas_two</gammas>
      </options>
    </module>
  </modules>
</grid>
