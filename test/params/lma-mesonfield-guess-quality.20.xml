<grid>
  <modules>
    <module>
      <id><name>gauge</name><type>MIO::LoadIldg</type></id>
      <options><file>lat/lat.sample.l4444.ildg</file></options>
    </module>
    <module>
      <id><name>gauge_fat</name><type>MIO::LoadIldg</type></id>
      <options><file>lat/fatlinks.l4444.ildg</file></options>
    </module>
    <module>
      <id><name>gauge_long</name><type>MIO::LoadIldg</type></id>
      <options><file>lat/longlinks.l4444.ildg</file></options>
    </module>
    <module>
      <id><name>stag</name><type>MAction::ImprovedStaggeredMILC</type></id>
      <options>
        <Ls>1</Ls>
        <boundary>1 1 1 1</boundary>
        <c1>1.0</c1>
        <c2>1.0</c2>
        <gaugefat>gauge_fat</gaugefat>
        <gaugelong>gauge_long</gaugelong>
        <mass>0.0</mass>
        <tad>1.0</tad>
        <twist>0 0 0</twist>
      </options>
    </module>
    <module>
      <id><name>stag_op</name><type>MFermion::StagOperators</type></id>
      <options><action>stag</action></options>
    </module>
    <module>
      <id><name>stag_m</name><type>MAction::ImprovedStaggeredMILC</type></id>
      <options>
        <Ls>1</Ls>
        <boundary>1 1 1 1</boundary>
        <c1>1.0</c1>
        <c2>1.0</c2>
        <gaugefat>gauge_fat</gaugefat>
        <gaugelong>gauge_long</gaugelong>
        <mass>0.01</mass>
        <tad>1.0</tad>
        <twist>0 0 0</twist>
      </options>
    </module>
    <module>
      <id><name>gauge_fatf</name><type>MUtilities::GaugeSinglePrecisionCast</type></id>
      <options><field>gauge_fat</field></options>
    </module>
    <module>
      <id><name>gauge_longf</name><type>MUtilities::GaugeSinglePrecisionCast</type></id>
      <options><field>gauge_long</field></options>
    </module>
    <module>
      <id><name>istag_m</name><type>MAction::ImprovedStaggeredMILCF</type></id>
      <options>
        <Ls>1</Ls>
        <boundary>1 1 1 1</boundary>
        <c1>1.0</c1>
        <c2>1.0</c2>
        <gaugefat>gauge_fatf</gaugefat>
        <gaugelong>gauge_longf</gaugelong>
        <mass>0.01</mass>
        <tad>1.0</tad>
        <twist>0 0 0</twist>
      </options>
    </module>
    <module>
      <id><name>stag_ama</name><type>MSolver::StagMixedPrecisionCG</type></id>
      <options>
        <innerAction>istag_m</innerAction>
        <isEven>false</isEven>
        <maxInnerIteration>10000</maxInnerIteration>
        <maxOuterIteration>10000</maxOuterIteration>
        <outerAction>stag_m</outerAction>
        <residual>1e-08</residual>
      </options>
    </module>
    <module>
      <id><name>epack</name><type>MSolver::StagFermionIRL</type></id>
      <options>
        <evenEigen>true</evenEigen>
        <lanczosParams>
          <Cheby><Npoly>11</Npoly><alpha>0.0</alpha><beta>24.0</beta></Cheby>
          <MaxIt>5000</MaxIt>
          <MinRes>0</MinRes>
          <Nk>370</Nk>
          <Nm>384</Nm>
          <Nstop>360</Nstop>
          <betastp>0</betastp>
          <resid>1e-08</resid>
        </lanczosParams>
        <multiFile>false</multiFile>
        <op>stag_op_schur</op>
        <output></output>
        <redBlack>true</redBlack>
      </options>
    </module>
    <module>
      <id><name>eig</name><type>MUtilities::ModifyEigenPackMILC</type></id>
      <options>
        <eigenPack>epack</eigenPack>
        <evenEigen>true</evenEigen>
        <mass>0.01</mass>
      </options>
    </module>
    <module>
      <id><name>cbpairs_l</name><type>MUtilities::EigenPackCBPairs</type></id>
      <options><action>stag</action><eigenPack>eig</eigenPack></options>
    </module>
    <module>
      <id><name>cbpairs_r</name><type>MUtilities::EigenPackCBPairs</type></id>
      <options><action>stag</action><eigenPack>eig</eigenPack></options>
    </module>
    <module>
      <id><name>eigfull</name><type>MUtilities::EigenPackFullPairs</type></id>
      <options><eigenPack>eig</eigenPack><action>stag</action></options>
    </module>
    <module>
      <id><name>noise</name><type>MNoise::StagTimeDilutedSpinColorDiagonal</type></id>
      <options><nsrc>2</nsrc><tStep>4</tStep></options>
    </module>
    <module>
      <id><name>gammas_g1</name><type>MFermion::SpinTaste</type></id>
      <options>
        <spinTaste>
          <gammas>(G1 G1)</gammas>
          <applyG5>false</applyG5>
          <gauge>gauge</gauge>
        </spinTaste>
        <labels></labels>
      </options>
    </module>
    <module>
      <id><name>mfwrite</name><type>MContraction::StagA2AMesonField</type></id>
      <options>
        <action></action>
        <block>12</block>
        <cbPairsLeft>cbpairs_l</cbPairsLeft>
        <cbPairsRight>cbpairs_r</cbPairsRight>
        <left></left>
        <lowModes>eig</lowModes>
        <mom><elem>0 0 0</elem></mom>
        <output>work/mfout-guess</output>
        <right>noise_vec</right>
        <gammas>gammas_g1</gammas>
      </options>
    </module>
    <module>
      <id><name>mf</name><type>MIO::LoadMesonField</type></id>
      <options>
        <file>work/mfout-guess.@traj@/G1_G1_0_0_0.h5</file>
        <dataset>G1_G1_0_0_0</dataset>
        <side></side>
        <lowModes></lowModes>
      </options>
    </module>
    <module>
      <id><name>lma_ref</name><type>MSolver::StagLMA</type></id>
      <options>
        <action>stag</action>
        <eigStart>0</eigStart>
        <lowModes>eig</lowModes>
        <nEigs>-1</nEigs>
        <projector>true</projector>
      </options>
    </module>
    <module>
      <id><name>lma_file</name><type>MFermion::StagLMAMesonFieldProp</type></id>
      <options>
        <action>stag</action>
        <lowModes>eig</lowModes>
        <gammas>gammas_g1</gammas>
        <labels>G1_G1</labels>
        <mesonField>mf</mesonField>
        <noiseIndex>0</noiseIndex>
        <nNoise>2</nNoise>
        <tA>0</tA>
        <tB>0</tB>
        <tStep>1</tStep>
        <eigStart>0</eigStart>
        <nEigs>-1</nEigs>
        <negFirst></negFirst>
        <pairScale></pairScale>
        <noise>noise_vec</noise>
      </options>
    </module>
    <module>
      <id><name>lma_fc_g1_t0</name><type>MUtilities::GammaMapElement</type></id>
      <options><map>lma_file_t0</map><label>G1_G1</label></options>
    </module>
    <module>
      <id><name>prop2f_file</name><type>MUtilities::PropToFermions</type></id>
      <options><prop>lma_fc_g1_t0</prop></options>
    </module>
    <module>
      <id><name>quark_zeroguess</name><type>MFermion::StagGaugePropLegacy</type></id>
      <options>
        <source>noise_vec</source>
        <solver>stag_ama</solver>
        <guess></guess>
        <spinTaste>
          <applyG5>false</applyG5>
          <gammas>(G1 G1)</gammas>
          <gauge>gauge</gauge>
        </spinTaste>
      </options>
    </module>
    <module>
      <id><name>gprop_ref_legacy</name><type>MFermion::StagGaugePropLegacy</type></id>
      <options>
        <source>noise_vec</source>
        <solver>lma_ref</solver>
        <guess></guess>
        <spinTaste>
          <applyG5>false</applyG5>
          <gammas>(G1 G1)</gammas>
          <gauge>gauge</gauge>
        </spinTaste>
      </options>
    </module>
    <module>
      <id><name>quark_liveguess</name><type>MFermion::StagGaugePropLegacy</type></id>
      <options>
        <source>noise_vec</source>
        <solver>stag_ama</solver>
        <guess>gprop_ref_legacy</guess>
        <spinTaste>
          <applyG5>false</applyG5>
          <gammas>(G1 G1)</gammas>
          <gauge>gauge</gauge>
        </spinTaste>
      </options>
    </module>
    <module>
      <id><name>quark_fileguess</name><type>MFermion::StagGaugePropLegacy</type></id>
      <options>
        <source>noise_vec</source>
        <solver>stag_ama</solver>
        <guess>prop2f_file</guess>
        <spinTaste>
          <applyG5>false</applyG5>
          <gammas>(G1 G1)</gammas>
          <gauge>gauge</gauge>
        </spinTaste>
      </options>
    </module>
  </modules>
  <parameters>
    <genetic>
      <maxCstGen>100</maxCstGen>
      <maxGen>1000</maxGen>
      <mutationRate>0.1</mutationRate>
      <popSize>20</popSize>
    </genetic>
    <graphFile></graphFile>
    <parallelWriteMaxRetry>-1</parallelWriteMaxRetry>
    <runId>lma-guess-quality</runId>
    <saveSchedule>false</saveSchedule>
    <scheduleFile></scheduleFile>
    <scheduler>
      <schedulerType>naive</schedulerType>
    </scheduler>
    <trajCounter>
      <end>10000</end>
      <start>20</start>
      <step>10000</step>
    </trajCounter>
  </parameters>
</grid>
