<grid>
  <modules>
    <module>
      <id>
        <name>gauge</name>
        <type>MIO::LoadIldg</type>
      </id>
      <options>
        <file>/workspaces/HadronsMILC/code/test/lat/lat.sample.l4444.ildg</file>
      </options>
    </module>
    <module>
      <id>
        <name>gauge_smear_fat</name>
        <type>MIO::LoadIldg</type>
      </id>
      <options>
        <file>/workspaces/HadronsMILC/code/test/lat/fatlinks.l4444.ildg</file>
      </options>
    </module>
    <module>
      <id>
        <name>gauge_smear_long</name>
        <type>MIO::LoadIldg</type>
      </id>
      <options>
        <file>/workspaces/HadronsMILC/code/test/lat/longlinks.l4444.ildg</file>
      </options>
    </module>
    <module>
      <id>
        <name>gauge_apbc</name>
        <type>MGauge::APBCGauge</type>
      </id>
      <options>
        <boundary>1 1 1 -1</boundary>
        <gauge>gauge</gauge>
      </options>
    </module>
    <module>
      <id>
        <name>epack</name>
        <type>MIO::StagLoadFermionEigenPack</type>
      </id>
      <options>
        <Ls>1</Ls>
        <filestem>/workspaces/HadronsMILC/code/test/eigen/vec_384_odd_ks_links_fine</filestem>
        <multiFile>false</multiFile>
        <redBlack>true</redBlack>
        <size>384</size>
      </options>
    </module>
    <module>
      <id>
        <name>evecs_mass_l</name>
        <type>MUtilities::ModifyEigenPackMILC</type>
      </id>
      <options>
        <eigenPack>epack</eigenPack>
        <evenEigen>false</evenEigen>
        <mass>0.1</mass>
        <normalizeCheckerboard>false</normalizeCheckerboard>
      </options>
    </module>
    <module>
      <id>
        <name>stag_mass_l</name>
        <type>MAction::ImprovedStaggeredMILC</type>
      </id>
      <options>
        <gaugefat>gauge_smear_fat</gaugefat>
        <gaugelong>gauge_smear_long</gaugelong>
        <mass>0.1</mass>
      </options>
    </module>
    <module>
      <id>
        <name>mf_onelink_mass_l_1</name>
        <type>MContraction::StagA2AMesonField</type>
      </id>
      <options>
        <action>stag_mass_l</action>
        <block>384</block>
        <left></left>
        <lowModes>evecs_mass_l</lowModes>
        <mom>
          <elem>0 0 0</elem>
        </mom>
        <output>/workspaces/HadronsMILC/code/test/e384n1dt1/mesons/m01/mf</output>
        <right></right>
        <spinTaste>
          <applyG5>false</applyG5>
          <gammas>(GXY G5T) (GXY G5Z) (GYZ G5T) (GYZ G5X)</gammas>
          <gauge>gauge_apbc</gauge>
        </spinTaste>
      </options>
    </module>
    <module>
      <id>
        <name>mf_onelink_mass_l_2</name>
        <type>MContraction::StagA2AMesonField</type>
      </id>
      <options>
        <action>stag_mass_l</action>
        <block>384</block>
        <left></left>
        <lowModes>evecs_mass_l</lowModes>
        <mom>
          <elem>0 0 0</elem>
        </mom>
        <output>/workspaces/HadronsMILC/code/test/e384n1dt1/mesons/m01/mf</output>
        <right></right>
        <spinTaste>
          <applyG5>false</applyG5>
          <gammas>(GZX G5T) (GZX G5Y) (GXT G5Z) (GXT G5Y) (GYT G5Z)</gammas>
          <gauge>gauge_apbc</gauge>
        </spinTaste>
      </options>
    </module>
    <module>
      <id>
        <name>mf_onelink_mass_l_3</name>
        <type>MContraction::StagA2AMesonField</type>
      </id>
      <options>
        <action>stag_mass_l</action>
        <block>384</block>
        <left></left>
        <lowModes>evecs_mass_l</lowModes>
        <mom>
          <elem>0 0 0</elem>
        </mom>
        <output>/workspaces/HadronsMILC/code/test/e384n1dt1/mesons/m01/mf</output>
        <right></right>
        <spinTaste>
          <applyG5>false</applyG5>
          <gammas>(GYT G5X) (GZT G5Y) (GZT G5X) (G5X G5) (G5Y G5) (G5Z G5) (G5T G5)</gammas>
          <gauge>gauge_apbc</gauge>
        </spinTaste>
      </options>
    </module>
  </modules>
  <parameters>
    <genetic>
      <maxCstGen>100</maxCstGen>
      <maxGen>1000</maxGen>
      <mutationRate>0.1</mutationRate>
      <popSize>20</popSize>
    </genetic>
    <graphFile></graphFile>
    <parallelWriteMaxRetry>-1</parallelWriteMaxRetry>
    <runId>LMI-RW-series-a-384-eigs-1-noise</runId>
    <saveSchedule>false</saveSchedule>
    <scheduleFile></scheduleFile>
    <trajCounter>
      <end>10000</end>
      <start>20</start>
      <step>10000</step>
    </trajCounter>
  </parameters>
</grid>
